#!/usr/bin/env bash
# ci/check-architecture — Run the architecture linter and report results.
# Exit non-zero on VIOLATION-level failures. QUESTIONABLE findings are warnings.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

echo "Running architecture linter..."
echo

# Build and run the Go-based architecture checker
cd "$REPO_ROOT"
go run ./cmd/check-architecture/
