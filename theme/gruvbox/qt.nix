##############################################################################
#
# Theme — Gruvbox Qt
#
# Purpose
# -------
# Qt style selection for the design system. Drives qt.style via the
# desktop module. It pairs with the GNOME platform theme
# (qt.platformTheme = "gnome", QGnomePlatform) so Qt applications render
# with the GTK/Gruvbox appearance without any KDE dependency.
#
##############################################################################

{
  style = "adwaita-dark";
}
