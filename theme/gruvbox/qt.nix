##############################################################################
#
# Theme — Gruvbox Qt
#
# Purpose
# -------
# Qt style selection for the design system. Drives qt.style in
# desktop/gnome. The style pairs with the GNOME platform theme
# (qt.platformTheme = "gnome") so Qt applications render with the GTK/
# Gruvbox appearance without any KDE dependency.
#
##############################################################################

{
  style = "adwaita-dark";
}
